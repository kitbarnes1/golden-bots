# Copy to terraform.tfvars (git-ignored) and fill in.
aws_region            = "eu-west-2"
domain                = "example.com"
subdomain             = "goldenbots"
cloudflare_account_id = "your-cloudflare-account-id"
cloudflare_zone_id    = "your-example.com-zone-id"
openrouter_api_key    = "sk-or-v1-..."
admin_password        = "choose-something-long"

# Your repo's GitHub OIDC subject; only it may deploy. See variables.tf for how to find it.
github_oidc_subject_prefix = "repo:your-github-user/your-repo"

# Optional
# instance_type               = "t4g.small"
# create_github_oidc_provider = false  # if your account already has the GitHub OIDC provider
# extra_app_env = {
#   AUTOPLAY_INTERVAL_MINUTES = "180"
#   # Leave AUTOPLAY_MODELS unset to draw from the automatically featured models.
#   MAX_CONCURRENT_GAMES      = "2"
# }
