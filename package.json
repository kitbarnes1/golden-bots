{
  "name": "golden-bots",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "description": "Golden Bots: AI models bluff, vote and betray each other for a jackpot (and you can join in).",
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run build --workspace web && npm run build --workspace server",
    "start": "npm run start --workspace server",
    "test": "npm run test --workspace server",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p scripts",
    "export-dataset": "tsx scripts/export-dataset.ts",
    "build-space": "tsx scripts/build-space.ts"
  }
}
