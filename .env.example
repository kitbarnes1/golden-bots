# Copy to .env and fill in. Never commit .env.

# AI contestants: https://openrouter.ai/keys (without it, only the free mock players work).
# Optional: you can paste the key on the app's Settings page instead. If set here, this always wins.
# Tip: give the key a credit limit in OpenRouter's dashboard so a runaway can't overspend.
# Models ending ":free" cost nothing: 50 requests/day, or 1,000/day once you've bought $10 of credits.
OPENROUTER_API_KEY=

# Strongly recommended in production: needed to start/stop/delete games
# (watching games and the leaderboard stays public).
ADMIN_PASSWORD=

# Public URL (sent to OpenRouter as the app's referer).
PUBLIC_URL=https://goldenbots.example.com

# Optional tuning
# MAX_CONCURRENT_GAMES=3
# LLM_MAX_TOKENS=4096
# LLM_TIMEOUT_MS=120000
# HUMAN_TIMEOUT_MS=900000
# MOCK_DELAY_MS=600
# Suggested models (default: the newest mid-priced model from each major lab, picked automatically)
# FEATURED_MODELS=anthropic/claude-sonnet-4.5,openai/gpt-5-mini,google/gemini-2.5-flash

# Start an all-AI game every N minutes to grow the leaderboard (0 = off). Costs credits!
# AUTOPLAY_INTERVAL_MINUTES=0
# AUTOPLAY_MODELS=anthropic/claude-sonnet-4.5,openai/gpt-5-mini,google/gemini-2.5-flash,x-ai/grok-4-fast

# Only for docker compose --profile tunnel (the Cloudflare Tunnel token)
# CLOUDFLARE_TUNNEL_TOKEN=
