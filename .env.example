# Copy to .env and fill in. Never commit .env.

# AI contestants: set up any of these (or none, and use the free mock players).
#
# OpenRouter: hundreds of models, pay as you go. Models ending ":free" cost nothing
# (50 requests/day, or 1,000/day once you've bought $10 of credits).
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
#
# Hugging Face Inference Providers: pay as you go (free accounts get no credits;
# PRO includes $2/month). Token needs the "Make calls to Inference Providers" permission.
# https://huggingface.co/settings/tokens
HF_TOKEN=
#
# Ollama: free open models on your own computer. Install from https://ollama.com,
# then e.g. `ollama pull llama3.1:8b`. Detected automatically at this address;
# set it to empty to turn Ollama off. From inside Docker use http://host.docker.internal:11434
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# Strongly recommended in production: needed to start/stop/delete games
# (watching games and the leaderboard stays public).
ADMIN_PASSWORD=

# Public URL (sent to OpenRouter as the app's referer).
PUBLIC_URL=https://goldenballs.thekitbarnes.com

# Optional tuning
# MAX_CONCURRENT_GAMES=3
# LLM_MAX_TOKENS=4096
# LLM_TIMEOUT_MS=120000
# HUMAN_TIMEOUT_MS=900000
# MOCK_DELAY_MS=600
# FEATURED_MODELS=anthropic/claude-sonnet-4.5,openai/gpt-5,hf:Qwen/Qwen2.5-72B-Instruct,ollama:llama3.1:8b

# Start an all-AI game every N minutes to grow the leaderboard (0 = off). Costs credits!
# AUTOPLAY_INTERVAL_MINUTES=0
# AUTOPLAY_MODELS=anthropic/claude-sonnet-4.5,openai/gpt-5-mini,google/gemini-2.5-flash,x-ai/grok-4-fast

# Only for docker compose --profile tunnel (the Cloudflare Tunnel token)
# CLOUDFLARE_TUNNEL_TOKEN=
